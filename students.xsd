<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

    <!-- Definition of simple non-empty string type -->
    <xs:simpleType name="NonEmptyString">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:whiteSpace value="collapse"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Definition of semester type (e.g. 1 to 8, or standard semester designation) -->
    <xs:simpleType name="SemesterType">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="10"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Definition of student element structure -->
    <xs:complexType name="StudentType">
        <xs:sequence>
            <xs:element name="name" type="NonEmptyString"/>
            <xs:element name="course" type="NonEmptyString"/>
            <xs:element name="semester" type="SemesterType"/>
        </xs:sequence>
        <xs:attribute name="id" type="NonEmptyString" use="required"/>
    </xs:complexType>

    <!-- Root element students -->
    <xs:element name="students">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="student" type="StudentType" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
        <!-- Ensure student id is unique within the document -->
        <xs:unique name="UniqueStudentId">
            <xs:selector xpath="student"/>
            <xs:field xpath="@id"/>
        </xs:unique>
    </xs:element>

</xs:schema>
